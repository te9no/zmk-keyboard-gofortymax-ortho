
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
 
/ {
    keymap {
        compatible = "zmk,keymap";
 
        default_layer {
            // Layer 0: o51go の Remap キーマップと同一構成(BTキー2個の追加のみ)
            bindings = <
            &bt BT_PRV   &bt BT_NXT
            &kp TAB   &kp Q &kp W &kp E &kp R    &kp T   &kp LBRC  &kp Y &kp U    &kp I   &kp O    &kp P    &kp DEL
            &kp CAPS  &kp A &kp S &kp D &kp F    &kp G   &kp SEMI  &kp H &kp J    &kp K   &kp L    &kp SEMI &kp RET
            &kp LSHFT &kp Z &kp X &kp C &kp V    &kp B   &kp MINUS &kp N &kp M    &kp COMMA &kp DOT &kp UP   &mo 1
            &kp LANG1 &mt LGUI LANG2 &kp LALT    &kp INT_MUHENKAN  &lt 2 RET      &kp BSPC  &kp SPACE       &lt 1 INT_HENKAN &kp LALT &kp LEFT &kp DOWN &kp RIGHT
            >;
        };
 
        layer1 {
            // Layer 1: 空。先頭キーだけ &studio_unlock (ZMK Studioでの編集を許可するため)。
            // それ以外の機能はビルド後にZMK Studioから自由に割り当てる。
            bindings = <
&studio_unlock &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
            >;
        };
 
        layer2 {
            // Layer 2: 空。ZMK Studioから割り当てる。
            bindings = <
&none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
            >;
        };
 
        layer3 {
            // Layer 3: 空。ZMK Studioから割り当てる。
            bindings = <
&none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none &none
&none &none &none &none &none &none &none &none &none &none &none &none
            >;
        };
    };
};
