#include <dt-bindings/zmk/matrix_transform.h>
#include "goforty_max-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &physical_layout0;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        row-gpios = <&akdk_d 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&akdk_d 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&akdk_d 13(GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&akdk_d 12(GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&akdk_d 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        col-gpios = <&akdk_d 17 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 16 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 15 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 10 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 9 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 8 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 7 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 6 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 5 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 4 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 3 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 2 (GPIO_ACTIVE_HIGH)>,
            <&akdk_d 1 (GPIO_ACTIVE_HIGH)>;
    };

    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <13>;
        map = <
            RC(0,0) RC(0,12)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12)
        >;
    };
};
